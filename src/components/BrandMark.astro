---
// The Ilm Vanta mark from the approved sample: an open book on an indigo tile with an amber dot.
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 30 30" aria-hidden="true" focusable="false"><rect width="30" height="30" rx="8" fill="#4F46E5"/><path d="M7 10.5c3-1.4 5.6-1.2 8 .6 2.4-1.8 5-2 8-.6v10c-3-1.4-5.6-1.2-8 .6-2.4-1.8-5-2-8-.6z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M15 11.1v10" stroke="#fff" stroke-width="1.8"/><circle cx="22.5" cy="7" r="2.2" fill="#F59E0B"/></svg>
