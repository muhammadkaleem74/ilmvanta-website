---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  phone?: boolean;
}

const { src, alt, eager = false, phone = false } = Astro.props;
const candidates = phone ? [180, 240, 320, 480] : [360, 640, 900, 1200, 1640];
const widths = candidates.filter((width) => width <= src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="png"
  widths={widths}
  sizes={phone ? '(max-width: 620px) 220px, 275px' : '(max-width: 700px) 100vw, 900px'}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  quality={72}
/>
