---
import Base from '../layouts/Base.astro';
import site from '../../site.config.json';
---
<Base title="Page not found · Ilm Vanta" description="This page doesn't exist." path="/404" noindex>
  <section class="lost">
    <div class="wrap">
      <p class="code" aria-hidden="true">404</p>
      <h1>This page isn't on the timetable</h1>
      <p>The link may be old or mistyped. If you were trying to sign in to your school, use School login.</p>
      <div class="ctas">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href={site.appUrl} rel="noopener">School login</a>
      </div>
    </div>
  </section>
</Base>
