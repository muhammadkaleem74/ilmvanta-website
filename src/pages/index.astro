---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import dashboard from '../assets/shots/web/dashboard.png';
---
<Base title="Ilm Vanta — School management software for Pakistan" description="Run admissions, attendance, fees, examinations, timetables, payroll and parent communication in one school ERP." path="/">
<section class="home-frame" aria-labelledby="hero-title">
      <div class="home-grid">
        <div class="hero-copy">
          <p class="eyebrow">School management for Pakistan</p>
          <h1 id="hero-title">Every school day.<br><em>One clear system.</em></h1>
          <p class="intro">Bring admissions, attendance, fees, exams and parent updates together in one workspace built for Pakistani schools.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/demo">Book a free demo</a>
            <a class="button button-outline" href="/tour"><svg aria-hidden="true" class="icon play"><use href="#i-play"/></svg>Explore product tour</a>
          </div>
        </div>
        <figure class="home-product">
          <a class="hero-window" href="/tour" aria-label="Explore the school dashboard">
            <div class="window-bar"><span class="window-dots"><i></i><i></i><i></i></span><span>School dashboard</span><svg aria-hidden="true" class="icon expand"><use href="#i-expand"/></svg></div>
            <Media src={dashboard} alt="Ilm Vanta dashboard showing attendance, admissions and fee summaries" eager />
          </a>
          <figcaption>Ilm Vanta demo school</figcaption>
        </figure>
      </div>
      <nav class="home-shortcuts" aria-label="Explore school workflows">
        <a href="/tour?screen=admissions"><svg aria-hidden="true" class="icon"><use href="#i-users"/></svg>Admissions</a>
        <a href="/tour?screen=fees"><svg aria-hidden="true" class="icon"><use href="#i-wallet"/></svg>Fee challans</a>
        <a href="/tour?screen=attendance"><svg aria-hidden="true" class="icon"><use href="#i-list"/></svg>Attendance</a>
        <a href="/tour?screen=exams"><svg aria-hidden="true" class="icon"><use href="#i-exam"/></svg>Exams &amp; results</a>
      </nav>
    </section>
</Base>
