---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import site from '../../site.config.json';
import type { ImageMetadata } from 'astro';

const web = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/web/*.png', { eager: true });
const app = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/app/*.png', { eager: true });
const W = (name: string) => web[`../assets/shots/web/${name}.png`].default;
const A = (name: string) => app[`../assets/shots/app/${name}.png`].default;

const digits = site.contact.whatsappNumber.replace(/\D/g, '');
const waText = encodeURIComponent("Assalam o alaikum, I'd like a demo of Ilm Vanta for my school.");
const waLink = `https://wa.me/${digits}?text=${waText}`;
const formReady = !!site.form.web3formsAccessKey && site.form.web3formsAccessKey !== 'WEB3FORMS_ACCESS_KEY';

const tour = [
  { id: 'dashboard', label: 'Overview', number: '01', title: 'Start the day knowing what matters.', text: 'Student strength, attendance, fee collection and pending admissions come together in one calm operational view.', image: W('dashboard'), alt: 'Ilm Vanta dashboard showing attendance, fees and admissions', url: 'app.ilmvanta.com/app/home' },
  { id: 'fees', label: 'Fees', number: '02', title: 'Every rupee, from challan to receipt.', text: 'Generate monthly challans, apply sibling discounts, record part payments and follow outstanding balances without separate sheets.', image: W('fee-challans'), alt: 'Fee challans with paid, part-paid and overdue states', url: 'app.ilmvanta.com/app/fee/challans' },
  { id: 'attendance', label: 'Attendance', number: '03', title: 'A faster register with fewer mistakes.', text: 'School calendars close holidays automatically while office and teacher views keep attendance history consistent.', image: W('attendance-sheet'), alt: 'Attendance register for Grade 5-A', url: 'app.ilmvanta.com/app/academics/attendance' },
  { id: 'exams', label: 'Exams', number: '04', title: 'Marks become results parents understand.', text: 'Subject marks flow into totals, grades, positions, remarks and polished report cards.', image: W('report-cards-list'), alt: 'Exam report cards ranked by percentage', url: 'app.ilmvanta.com/app/exams/report-cards' },
  { id: 'timetable', label: 'Timetable', number: '05', title: 'Build the week without teacher clashes.', text: 'Coordinate sections, rooms and campus bell schedules, then surface periods that need a cover.', image: W('timetable'), alt: 'Weekly timetable grid with subjects and teachers', url: 'app.ilmvanta.com/app/academics/timetable' },
  { id: 'payroll', label: 'Payroll', number: '06', title: 'Run salaries with the details already connected.', text: 'Salary structures, allowances, provident fund, EOBI, tax and attendance deductions produce clear payslips.', image: W('payroll-run'), alt: 'Finalized monthly payroll run', url: 'app.ilmvanta.com/app/hr/payroll' },
];
---
<Base title="Ilm Vanta — School management software for Pakistan" description="Run admissions, attendance, fees, examinations, timetables, payroll and parent communication in one school ERP." path="/">
  <section class="hero-v2" aria-labelledby="hero-title">
    <div class="hero-orbit orbit-one" aria-hidden="true"></div>
    <div class="hero-orbit orbit-two" aria-hidden="true"></div>
    <div class="wrap hero-intro">
      <p class="eyebrow">The operating system for your school</p>
      <h1 id="hero-title">Every school day.<br><span>One clear system.</span></h1>
      <p class="lede">Ilm Vanta connects admissions, attendance, fees, exams, timetables and parent communication—built around how Pakistani schools work.</p>
      <div class="hero-actions">
        <a class="btn btn-amber" href="#demo">Book a Free Demo <Icon name="arrow-right" size={18} /></a>
        <a class="quiet-link" href="#product">Watch the product tour <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="wrap product-theatre">
      <div class="theatre-shell">
        <div class="theatre-topline"><span><i></i><i></i><i></i></span><b>app.ilmvanta.com</b><span class="secure">School workspace · Secure</span></div>
        <div class="hero-dashboard"><Media src={W('dashboard')} alt="Ilm Vanta school dashboard" eager={true} /></div>
      </div>
      <div class="layer-card layer-attendance">
        <div class="layer-label"><span class="live-dot"></span> Today’s register</div>
        <div class="layer-media"><Media src={W('attendance-sheet')} alt="Attendance register" eager={true} /></div>
      </div>
      <div class="layer-card layer-fee">
        <div class="layer-label"><Icon name="receipt" size={15} /> Fee detail</div>
        <div class="layer-media"><Media src={W('fee-challan-detail')} alt="Fee challan with sibling discount" eager={true} /></div>
      </div>
    </div>
    <div class="wrap hero-foot"><span>Office web app</span><span>Parent &amp; teacher Android app</span><span>English &amp; Urdu</span><span>Multi-campus ready</span></div>
  </section>

  <section class="bento-section" id="features" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-lead split-lead">
        <div><p class="eyebrow">One connected school</p><h2 id="features-title">Workflows that speak to each other.</h2></div>
        <p>Information entered at admission becomes useful everywhere else—from the daily register and challan to results and parent updates.</p>
      </div>

      <div class="bento-grid">
        <article class="bento bento-admissions">
          <div class="bento-copy"><span class="bento-index">01</span><div><p class="kicker">Admissions</p><h3>From first enquiry to enrolled student.</h3><p>Applications, testing, approvals and sibling guardians stay in one record.</p></div></div>
          <div class="bento-screen crop-students"><Media src={W('students-list')} alt="Student list in Ilm Vanta" /></div>
        </article>

        <article class="bento bento-fees">
          <div class="bento-copy"><span class="bento-index">02</span><div><p class="kicker">Fee management</p><h3>Collection without loose ends.</h3><p>Challans, sibling discounts, part payments and receipts stay reconciled.</p></div></div>
          <div class="document-stack"><Media src={W('fee-challan-detail')} alt="Detailed school fee challan" /></div>
          <div class="mini-stat"><span>Payment status</span><b>Paid</b><small>Receipt recorded</small></div>
        </article>

        <article class="bento bento-attendance">
          <div class="bento-copy"><span class="bento-index">03</span><div><p class="kicker">Attendance</p><h3>The whole register, without the morning rush.</h3><p>Teachers can mark offline; weekends and school holidays close automatically.</p></div></div>
          <div class="bento-screen crop-attendance"><Media src={W('attendance-sheet')} alt="Student attendance sheet" /></div>
        </article>

        <article class="bento bento-exams">
          <div class="bento-copy"><span class="bento-index">04</span><div><p class="kicker">Exams &amp; results</p><h3>Results ready to share.</h3><p>Your grade scale, position and teacher remarks—laid out clearly.</p></div></div>
          <div class="report-peek"><Media src={W('report-card')} alt="Printable student report card" /></div>
        </article>

        <article class="bento bento-timetable">
          <div class="bento-copy"><span class="bento-index">05</span><div><p class="kicker">Timetable</p><h3>A week that fits together.</h3><p>Coordinate sections, teachers, rooms and covers without collisions.</p></div></div>
          <div class="bento-screen crop-timetable"><Media src={W('timetable')} alt="School timetable grid" /></div>
        </article>

        <article class="bento bento-staff">
          <div class="bento-copy"><span class="bento-index">06</span><div><p class="kicker">Staff &amp; payroll</p><h3>People records meet payroll.</h3><p>Leave, attendance and salary structures come together for the monthly run.</p></div></div>
          <div class="payroll-peek"><Media src={W('payroll-run')} alt="School payroll run" /></div>
        </article>
      </div>
    </div>
  </section>

  <section class="tour-v2" id="product" aria-labelledby="tour-title">
    <div class="wrap">
      <div class="tour-heading"><p class="eyebrow">Inside Ilm Vanta</p><h2 id="tour-title">See the school move in real time.</h2><p>Authentic screens from a demo school with made-up students and staff.</p></div>
      <div class="tour-nav" role="tablist" aria-label="Product tour screens">
        {tour.map((item, index) => <button type="button" role="tab" id={`tab-${item.id}`} aria-controls={`panel-${item.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}><span>{item.number}</span>{item.label}</button>)}
      </div>
      <div class="tour-stage">
        {tour.map((item, index) => (
          <div class="tour-panel" role="tabpanel" id={`panel-${item.id}`} aria-labelledby={`tab-${item.id}`} hidden={index !== 0}>
            <div class="tour-copy"><span class="tour-count">{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></div>
            <div class="browser">
              <div class="bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="url">{item.url}</span></div>
              <Media src={item.image} alt={item.alt} eager={true} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mobile-v2" id="mobile" aria-labelledby="mobile-title">
    <div class="wrap mobile-layout">
      <div class="mobile-narrative">
        <p class="eyebrow">One app, two roles, two languages</p>
        <h2 id="mobile-title">The right school view, wherever the day happens.</h2>
        <p class="lede">Parents see what matters for their children. Teachers see today’s periods, covers and attendance—even when the connection drops.</p>
        <div class="role-notes">
          <div><span>01</span><p><b>Parents stay informed</b>Attendance, fees, results and announcements in English or Urdu.</p></div>
          <div><span>02</span><p><b>Teachers stay moving</b>Today’s timetable and an offline-ready class register.</p></div>
        </div>
      </div>
      <div class="device-scene">
        <div class="device device-parent"><span>Parent</span><div class="phone"><Media src={A('parent-home-en')} alt="Parent app home in English" phone={true} /></div></div>
        <div class="device device-teacher"><span>Teacher</span><div class="phone"><Media src={A('teacher-today')} alt="Teacher app showing today’s periods" phone={true} /></div></div>
        <div class="device device-urdu"><span lang="ur">اردو</span><div class="phone"><Media src={A('parent-home-ur')} alt="Parent app home in Urdu" phone={true} /></div></div>
      </div>
    </div>
  </section>

  <section class="why-v2" id="solutions" aria-labelledby="why-title">
    <div class="wrap why-layout">
      <div class="why-main">
        <p class="eyebrow">Made here, for schools here</p>
        <h2 id="why-title">Not a generic ERP with “school” added later.</h2>
        <p>Ilm Vanta is shaped around Pakistani school realities: guardian CNICs, rupee-based challans, sibling discounts, campus calendars, EOBI, provident fund and Urdu communication.</p>
        <a class="text-link" href="#demo">See it with your school <Icon name="arrow-right" size={18} /></a>
      </div>
      <div class="why-proof">
        <article><Icon name="wifi-off" /><span>Works through patchy internet</span><p>Teacher attendance can be taken offline and synced later.</p></article>
        <article><Icon name="network" /><span>Grows across campuses</span><p>Campus calendars, classes and bell schedules stay distinct.</p></article>
        <article><Icon name="shield-check" /><span>Clear access by role</span><p>Each person sees the work and children relevant to them.</p></article>
      </div>
    </div>
    <div class="wrap proof-ribbon"><span>Guardian CNICs</span><span>Sibling discounts</span><span>Fee challans in PKR</span><span>English + Urdu</span><span>EOBI + PF payroll</span></div>
  </section>

  <section class="pricing-v2" id="pricing" aria-labelledby="pricing-title">
    <div class="wrap">
      <div class="pricing-lead"><div><p class="eyebrow">Plans that grow with you</p><h2 id="pricing-title">Start with the work you need.</h2></div><p>Every plan is based on student count. Choose monthly, quarterly or yearly billing.</p></div>
      <div class="plans-v2">
        {site.plans.map((plan, index) => (
          <article class={plan.highlight ? 'plan-v2 plan-standard' : 'plan-v2'}>
            <div class="plan-top"><span>0{index + 1}</span>{plan.badge && <b>{plan.badge}</b>}</div>
            <h3>{plan.name}</h3><p class="plan-for">{plan.for}</p>
            <div class="plan-price">{site.pricing.showStartingPrice ? site.pricing.startingPriceText : 'Let’s discuss your school'}<small>Pricing based on student count</small></div>
            <ul>{plan.modules.map((module) => <li><Icon name="check" size={16} />{module.replace(/^\+/, '')}</li>)}</ul>
            <a class={plan.highlight ? 'btn btn-primary' : 'btn btn-outline'} href="#demo">Book a Free Demo</a>
          </article>
        ))}
      </div>
      <div class="ask-addon"><div><span>Optional intelligence layer</span><b>{site.addOn.name}</b></div><p>{site.addOn.text}</p><Icon name="arrow-right" /></div>
    </div>
  </section>

  <section class="faq-v2" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-layout">
      <div class="faq-intro"><p class="eyebrow">A few practical answers</p><h2 id="faq-title">Before you book a demo.</h2><p>We can walk through your own class and fee structure on the call.</p></div>
      <div class="faq-list">
        <details><summary>Do parents have to install an app?</summary><p>No. On Standard and Premium, parents can use the Android app or the parent portal in any browser.</p></details>
        <details><summary>Does the app work in Urdu?</summary><p>Yes. The parent and teacher app works in English and Urdu. Office screens are in English.</p></details>
        <details><summary>Can teachers use the app on Basic?</summary><p>Yes. The teacher app is included on every plan.</p></details>
        <details><summary>Can we manage more than one campus?</summary><p>Yes. Classes, bell schedules and holidays can be configured per campus.</p></details>
        <details><summary>Who owns our school data?</summary><p>{site.faq.dataExportAnswer}</p></details>
      </div>
    </div>
  </section>

  <section class="demo-v2" id="demo" aria-labelledby="demo-title">
    <div class="wrap demo-shell">
      <div class="demo-copy">
        <p class="eyebrow">A better school day starts here</p><h2 id="demo-title">See Ilm Vanta with your school’s classes.</h2><p>Tell us a little about your school. We’ll arrange a focused walkthrough—not a generic sales presentation.</p>
        <div class="contact-rail">
          <a href={waLink} rel="noopener"><span>WhatsApp</span><b>{site.contact.phone}</b></a>
          <a href={`mailto:${site.contact.email}`}><span>Email</span><b>{site.contact.email}</b></a>
          <div><span>Office hours</span><b>{site.contact.officeHours}</b></div>
        </div>
      </div>
      <form class="demo-form" id="demoForm" action="https://api.web3forms.com/submit" method="post" data-ready={formReady ? 'true' : 'false'}>
        <input type="hidden" name="access_key" value={site.form.web3formsAccessKey}><input type="hidden" name="subject" value={site.form.subject}><input type="hidden" name="from_name" value="ilmvanta.com"><input type="hidden" name="redirect" value={`${site.siteUrl}/#demo`}>
        <div class="hp" aria-hidden="true"><label>Leave this empty<input type="checkbox" name="botcheck" tabindex="-1"></label></div>
        <div class="form-head"><span>01</span><p><b>Tell us about your school</b><small>Required fields are marked</small></p></div>
        <label class="full">School name <em>Required</em><input type="text" name="school" required autocomplete="organization" maxlength="120"></label>
        <label>Your name <em>Required</em><input type="text" name="name" required autocomplete="name" maxlength="80"></label>
        <label>Your role<select name="role"><option>Owner</option><option>Principal</option><option>Administrator</option><option>Other</option></select></label>
        <label>City<input type="text" name="city" autocomplete="address-level2" maxlength="60"></label>
        <label>Number of students<select name="students"><option>Under 200</option><option>200 – 500</option><option>500 – 1,000</option><option>Over 1,000</option></select></label>
        <label>Phone / WhatsApp <em>Required</em><input type="tel" name="phone" required autocomplete="tel" placeholder="03XX XXXXXXX" maxlength="20"></label>
        <label>Email <small>Optional</small><input name="email" type="email" autocomplete="email" maxlength="120"></label>
        <label class="full">Anything we should know? <small>Optional</small><textarea name="message" maxlength="1500"></textarea></label>
        {formReady ? <div class="full submit-row"><button class="btn btn-amber" type="submit" id="demoSubmit">Request a Demo <Icon name="arrow-right" size={18} /></button><span>No obligation. We’ll contact you to arrange a time.</span></div> : <p class="form-msg off" role="status">Please <a href={waLink}>WhatsApp us</a> to book.</p>}
        <p class="form-msg ok" id="formOk" role="status" hidden>Thank you. We have your request and will call you to set a time.</p><p class="form-msg err" id="formErr" role="alert" hidden>Sorry, the request didn’t go through. Please try again, or <a href={waLink}>WhatsApp us</a>.</p>
      </form>
    </div>
  </section>

  <script is:inline>
    (function () {
      var tabs = Array.prototype.slice.call(document.querySelectorAll('[role="tab"]'));
      function select(tab) { tabs.forEach(function (item) { var active = item === tab; item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; document.getElementById(item.getAttribute('aria-controls')).hidden = !active; }); }
      tabs.forEach(function (tab, index) { tab.addEventListener('click', function () { select(tab); }); tab.addEventListener('keydown', function (event) { var nextIndex = event.key === 'ArrowRight' ? index + 1 : event.key === 'ArrowLeft' ? index - 1 : null; if (nextIndex === null) return; var next = tabs[(nextIndex + tabs.length) % tabs.length]; select(next); next.focus(); event.preventDefault(); }); });
      var form = document.getElementById('demoForm');
      if (form && form.dataset.ready === 'true') { var ok = document.getElementById('formOk'), err = document.getElementById('formErr'), submit = document.getElementById('demoSubmit'); form.addEventListener('submit', function (event) { event.preventDefault(); ok.hidden = true; err.hidden = true; if (!form.checkValidity()) { form.reportValidity(); return; } submit.disabled = true; submit.textContent = 'Sending…'; var data = Object.fromEntries(new FormData(form)); delete data.redirect; fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) }).then(function (response) { return response.json().then(function (json) { return response.ok && json.success; }); }).then(function (sent) { if (sent) { ok.hidden = false; form.reset(); } else err.hidden = false; }, function () { err.hidden = false; }).then(function () { submit.disabled = false; submit.textContent = 'Request a Demo'; }); }); }
    })();
  </script>
</Base>
