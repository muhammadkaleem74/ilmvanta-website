---
import Base from '../layouts/Base.astro';
import site from '../../site.config.json';
import { contactEmail } from '../data/contact';

const digits = site.contact.whatsappNumber.replace(/\D/g, '');
const message = encodeURIComponent("Assalam o alaikum, I'd like a demo of Ilm Vanta for my school.");
const whatsapp = `https://wa.me/${digits}?text=${message}`;
const formReady = !!site.form.web3formsAccessKey && site.form.web3formsAccessKey !== 'WEB3FORMS_ACCESS_KEY';
---
<Base title="Book a free demo | Ilm Vanta" description="Request an Ilm Vanta walkthrough based on your school’s classes, fee structure and priorities." path="/demo">
<section class="demo-section" id="demo" aria-labelledby="demo-title">
      <div class="container section demo-layout">
        <div class="demo-copy">
          <p class="eyebrow">Book a free demo</p><h1 id="demo-title">See Ilm Vanta with your school’s classes.</h1>
          <p>Tell us a little about your school so the walkthrough can focus on the work you do every day.</p>
          <div class="demo-preview demo-contact">
            <p><strong>WhatsApp</strong> <a href={whatsapp}>{site.contact.phone}</a></p>
            <p><strong>Email</strong> <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
            <p><strong>Office hours</strong> {site.contact.officeHours}</p>
          </div>
        </div>
        {formReady ? (
        <form id="demo-form" class="demo-form" action="https://api.web3forms.com/submit" method="post">
          <input type="hidden" name="access_key" value={site.form.web3formsAccessKey}>
          <input type="hidden" name="subject" value={site.form.subject}>
          <input type="hidden" name="from_name" value="ilmvanta.com">
          <input type="hidden" name="offer" value="90-day paid pilot" disabled>
          <div class="hp" aria-hidden="true"><label>Leave this empty<input type="checkbox" name="botcheck" tabindex="-1"></label></div>
          <noscript><p class="form-msg off">To book a demo, <a href={whatsapp}>contact us on WhatsApp</a>.</p></noscript>
          <div class="form-progress" aria-hidden="true"><span class="current"></span><span></span></div>
          <div id="demo-fields">
            <h2 id="details-title" tabindex="-1">Tell us about your school</h2>
            <p class="form-caption">Step 1 of 2 · Required fields marked *</p>
            <p class="demo-pilot" id="demo-pilot" hidden><strong>90-day paid pilot.</strong> Your request includes monthly pilot billing. We’ll confirm availability and renewal terms before you enrol.</p>
            <fieldset class="form-grid" disabled>
              <legend class="sr-only">School and contact details</legend>
              <label>School name *<input type="text" name="school" autocomplete="organization" placeholder="e.g. Crescent School" maxlength="100" required></label>
              <label>Your name *<input type="text" name="name" autocomplete="name" placeholder="e.g. Ayesha Khan" maxlength="100" required></label>
              <label>Your role<select name="role"><option value="">Select a role</option><option>Owner</option><option>Principal</option><option>Administrator</option><option>Other</option></select></label>
              <label>City<input type="text" name="city" autocomplete="address-level2" placeholder="e.g. Lahore" maxlength="80"></label>
              <label>Number of students<select name="students"><option value="">Select a range</option><option>Under 200</option><option>200–499</option><option>500–1,000</option><option>Over 1,000</option></select></label>
              <label>Phone / WhatsApp *<input type="tel" name="phone" autocomplete="tel" placeholder="0300 0000000" maxlength="25" required></label>
              <label>Email <span class="optional">(optional)</span><input type="email" name="email" autocomplete="email" placeholder="you@example.com" maxlength="150"></label>
              <label>Plan<select name="plan"><option value="">Help me choose</option>{site.plans.map((plan) => <option>{plan.name}</option>)}</select></label>
              <label id="demo-billing">Billing preference<select name="billing"><option value="">Help me choose</option><option>Monthly</option><option>Quarterly</option><option>Yearly</option></select></label>
              <label class="full">What would you like to see? <span class="optional">(optional)</span><textarea name="message" placeholder="e.g. Fee collection and parent access" maxlength="500" rows="2"></textarea></label>
            </fieldset>
            <button class="button button-primary form-cta" type="submit" disabled>Review demo request</button>
          </div>
          <div id="demo-review" hidden>
            <h2 id="review-title" tabindex="-1">Review your request</h2>
            <p class="form-caption">Step 2 of 2 · Check your details</p>
            <dl class="review-list" id="review-list"></dl>
            <div class="form-actions"><button class="button button-white" type="button" id="edit-demo">Edit details</button><button class="button button-primary" type="submit" id="send-demo">Request a demo</button></div>
            <p class="form-msg err" id="demo-error" role="alert" hidden>We couldn’t confirm your request. Try again or <a href={whatsapp}>contact us on WhatsApp</a>.</p>
          </div>
          <div id="demo-success" hidden>
            <span class="success-icon"><svg aria-hidden="true" class="icon"><use href="#i-check"/></svg></span>
            <h2 id="success-title" tabindex="-1">Demo request sent</h2>
            <p>Thank you. We’ll contact you to arrange your walkthrough.</p>
            <button class="button button-white" type="button" id="reset-demo">Start another request</button>
          </div>
        </form>
        ) : <p class="form-msg off">To request a demo, <a href={whatsapp}>contact us on WhatsApp</a>.</p>}
      </div>
    </section>
</Base>
